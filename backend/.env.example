NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/gymdb?schema=public"

# Use long random strings in production, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay dashboard -> Settings -> Webhooks (optional but recommended)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Your frontend origin, used for CORS + cookies
CLIENT_URL=http://localhost:5173
